# Copy to .env and fill in. Never commit the real .env file.

# --- Cloud providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Web research (Verified Research mode) ---
# Get a free key at https://tavily.com (1000 searches/month free tier)
TAVILY_API_KEY=

# --- Local provider ---
OLLAMA_HOST=http://localhost:11434

# --- Supabase (Postgres + pgvector + Auth + Storage) ---
# For local dev, run `supabase start` and use the printed local URL/anon key.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# --- Behavior ---
# One of: local_only | hybrid_openai_default | hybrid_openai_gemini_verify
ACTIVE_PROFILE=hybrid_openai_default
LOG_LEVEL=INFO
